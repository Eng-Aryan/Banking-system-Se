pipeline {
    agent any

    tools {
        nodejs 'node18'
    }

    options {
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    parameters {
        string(
            name: 'SONAR_PROJECT_KEY',
            defaultValue: '',
            description: 'Exact project key from SonarQube'
        )

        string(
            name: 'STAGING_URL',
            defaultValue: 'http://host.docker.internal:8000',
            description: 'Bank frontend URL reachable from Jenkins'
        )

        booleanParam(
            name: 'DEPLOY_PRODUCTION',
            defaultValue: false,
            description: 'Run the Ansible production deployment'
        )

        string(
            name: 'PRODUCTION_HEALTH_URL',
            defaultValue: '',
            description: 'Production health URL reachable from Jenkins'
        )
    }

    environment {
        APP_NAME = 'bank-system'

        SONAR_HOST_URL = 'http://sonarqube:9000'

        MONGO_USER = 'bank'
        MONGO_PASS = credentials('banking-mongo-password')
        JWT_SECRET = credentials('banking-mern-jwt-secret')

        COOKIE_SECURE = 'false'
    }

    stages {
        // Jenkins automatically checks out the repository
        // using the credentials configured in the job.

        stage('Check Configuration & Tools') {
            steps {
                script {
                    if (!params.SONAR_PROJECT_KEY.trim()) {
                        error(
                            'Set SONAR_PROJECT_KEY to your actual SonarQube project key.'
                        )
                    }

                    if (
                        params.DEPLOY_PRODUCTION &&
                        !params.PRODUCTION_HEALTH_URL.trim()
                    ) {
                        error(
                            'Set PRODUCTION_HEALTH_URL before production deployment.'
                        )
                    }
                }

                sh '''
                    set -eu

                    node --version
                    npm --version
                    git --version

                    docker --version
                    docker compose version
                    docker info > /dev/null

                    gitleaks version
                    python3 --version
                    curl --version > /dev/null
                '''
            }
        }

        // Scan before installing dependencies.
        stage('Secret Detection') {
            steps {
                sh '''
                    gitleaks detect \
                      --source=. \
                      --no-git \
                      --redact
                '''
            }
        }

        stage('Install Dependencies') {
            steps {
                dir('client') {
                    sh '''
                        set -eu
                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi
                    '''
                }

                dir('server') {
                    sh '''
                        set -eu
                        if [ -f package-lock.json ]; then
                            npm ci
                        else
                            npm install
                        fi
                    '''
                }
            }
        }

        stage('Pre-Build Phase') {
            parallel {
                stage('Code Linting') {
                    steps {
                        dir('client') {
                            sh 'npm run lint'
                        }

                        dir('server') {
                            sh 'npm run lint'
                        }
                    }
                }

                stage('SAST (SonarQube Analysis)') {
                    steps {
                        script {
                            def scannerHome = tool 'sonar-scanner'

                            withEnv([
                                "SCANNER_HOME=${scannerHome}",
                                "SONAR_PROJECT_KEY=${params.SONAR_PROJECT_KEY.trim()}"
                            ]) {
                                withCredentials([
                                    string(
                                        credentialsId: 'sonar-token-for-bank',
                                        variable: 'SONAR_TOKEN'
                                    )
                                ]) {
                                    sh '''
                                        set +x

                                        "$SCANNER_HOME/bin/sonar-scanner" \
                                          -Dsonar.login="$SONAR_TOKEN" \
                                          -Dsonar.projectKey="$SONAR_PROJECT_KEY" \
                                          -Dsonar.projectName="Bank System" \
                                          -Dsonar.sources=client/src,server/src \
                                          -Dsonar.exclusions="**/node_modules/**,**/dist/**,**/coverage/**" \
                                          -Dsonar.host.url="$SONAR_HOST_URL" \
                                          -Dsonar.qualitygate.wait=true \
                                          -Dsonar.qualitygate.timeout=300
                                    '''
                                }
                            }
                        }
                    }
                }

                stage('Dependency & Vulnerability Scanning') {
                    steps {
                        dir('server') {
                            sh 'npm audit --audit-level=high'
                        }

                        dir('client') {
                            sh 'npm audit --audit-level=high'
                        }
                    }
                }

                stage('Automated Tests') {
                    steps {
                        dir('server') {
                            sh 'npm test'
                        }
                    }
                }
            }
        }

        stage('Build Phase') {
            stages {
                stage('Build Frontend') {
                    steps {
                        dir('client') {
                            sh 'npm run build'
                        }
                    }
                }

                stage('Build Docker Images') {
                    steps {
                        sh 'docker compose build'
                    }
                }
            }
        }

        stage('Staging Deployment & Testing') {
            stages {
                stage('Staging Deployment') {
                    steps {
                        // Use the same project name for every deployment.
                        // No "down" is needed before updating containers.
                        sh '''
                            docker compose \
                              -p banking-system-se-main \
                              up -d --wait --wait-timeout 120
                        '''
                    }
                }

                stage('Staging Smoke Test') {
                    steps {
                        withEnv([
                            "BANK_STAGING_URL=${params.STAGING_URL.trim()}"
                        ]) {
                            sh '''
                                curl \
                                  --fail \
                                  --silent \
                                  --show-error \
                                  --retry 12 \
                                  --retry-delay 5 \
                                  --retry-connrefused \
                                  --max-time 15 \
                                  --output /dev/null \
                                  "$BANK_STAGING_URL"
                            '''
                        }
                    }
                }
            }
        }

        stage('Production Deployment') {
            when {
                expression {
                    return params.DEPLOY_PRODUCTION
                }
            }

            stages {
                stage('Manual Approval') {
                    steps {
                        timeout(time: 30, unit: 'MINUTES') {
                            input(
                                message: 'Deploy this build to production?',
                                ok: 'Deploy'
                            )
                        }
                    }
                }

                stage('Deploy with Ansible') {
                    steps {
                        sh '''
                            set -eu
                            ansible-playbook --version
                            test -f ansible/inventory.ini
                            test -f ansible/deploy.yml
                        '''

                        withCredentials([
                            sshUserPrivateKey(
                                credentialsId: 'aws-ec2-ssh-key',
                                keyFileVariable: 'SSH_KEY'
                            )
                        ]) {
                            sh '''
                                set +x

                                ansible-playbook \
                                  -i ansible/inventory.ini \
                                  ansible/deploy.yml \
                                  --private-key "$SSH_KEY"
                            '''
                        }
                    }
                }

                stage('Production Smoke Test') {
                    steps {
                        withEnv([
                            "BANK_PRODUCTION_HEALTH_URL=${params.PRODUCTION_HEALTH_URL.trim()}"
                        ]) {
                            sh '''
                                curl \
                                  --fail \
                                  --silent \
                                  --show-error \
                                  --retry 12 \
                                  --retry-delay 5 \
                                  --retry-connrefused \
                                  --max-time 15 \
                                  --output /dev/null \
                                  "$BANK_PRODUCTION_HEALTH_URL"
                            '''
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Bank System pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the failed stage in Console Output.'
        }

        always {
            cleanWs()
        }
    }
}